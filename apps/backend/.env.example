# Database (required)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Flask Web
APP_ENV=dev
FLASK_SECRET_KEY=
AUTH_ALLOW_HEADER_FALLBACK=true

# Qwen / Tongyi pricing suggestion
LLM_PROVIDER=tongyi
TONGYI_API_KEY=
TONGYI_MODEL=qwen-plus
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Fliggy guest / merchant crawling
COMPETITOR_CRAWL_USER_AGENT=fliggy-ai-mvp-bot/1.0 (+internal-testing)
COMPETITOR_CRAWL_TIMEOUT_SEC=20
FLIGGY_PLAYWRIGHT_TIMEOUT_SEC=30
FLIGGY_PLAYWRIGHT_WAIT_AFTER_LOAD_MS=1800

# Fliggy platform fallback config
FLIGGY_APP_KEY=
FLIGGY_APP_SECRET=
FLIGGY_SESSION=
FLIGGY_SIGN_METHOD=md5
FLIGGY_VERSION=2.0
FLIGGY_FORMAT=json
FLIGGY_TIMEOUT_SEC=15
FLIGGY_GATEWAY=https://eco.taobao.com/router/rest
FLIGGY_HOTEL_ID=
FLIGGY_ROOM_STATUS_HOTEL_ID=
FLIGGY_PRICE_PUSH_ENABLED=false
FLIGGY_PRICE_PUSH_METHOD=taobao.xhotel.rate.update
FLIGGY_PRICE_PUSH_PAYLOAD_JSON=

# Default room inventory fallback
ROOM_STATUS_AUTO_ENABLED=false
ROOM_STATUS_SHOP_ID=1
ROOM_STATUS_TOTAL_ROOMS=20
ROOM_STATUS_AVAILABLE_ROOMS=5
ROOM_STATUS_CURRENT_PRICE=299

# Celery / Redis scheduling
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
COMPETITOR_ROOM_PRICE_SCHEDULE_ENABLED=true
COMPETITOR_ROOM_PRICE_SCHEDULE_INTERVAL_MINUTES=120
COMPETITOR_ROOM_PRICE_SCHEDULE_MAX_HOTELS_PER_SHOP=20
COMPETITOR_ROOM_PRICE_SCHEDULE_HEADLESS=true
COMPETITOR_ROOM_PRICE_SCHEDULE_DEBUG_URL=http://127.0.0.1:9222
